@using SistemadeRenta.Domain.Entities
@model Pago
@{
    ViewData["Title"] = "Registrar Pago";
    var reserva = ViewBag.Reserva as Reserva;
    int idReserva = (int)(ViewData["IdReserva"] ?? 0);
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-0">Registrar Pago de Reserva</h2>
                <small class="text-muted">Completa los datos del cobro para generar el registro</small>
            </div>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Volver</a>
        </div>

        @if (reserva != null)
        {
            <div class="card shadow-sm border-0 bg-light mb-4">
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-sm-4">
                            <div class="text-muted small">Código de seguimiento</div>
                            <div class="fw-semibold">@reserva.CodigoSeguimiento</div>
                        </div>
                        <div class="col-sm-4">
                            <div class="text-muted small">Vehículo</div>
                            <div class="fw-semibold">
                                @(reserva.Vehiculo != null ? $"{reserva.Vehiculo.Marca} {reserva.Vehiculo.Modelo}" : $"#{reserva.IdVehiculo}")
                            </div>
                        </div>
                        <div class="col-sm-4">
                            <div class="text-muted small">Fechas</div>
                            <div class="fw-semibold">
                                @reserva.FechaInicio.ToString("dd/MM/yyyy") - @reserva.FechaFin.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form asp-action="Registrar" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idReserva" value="@idReserva" />

                    @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger py-2"></div>
                    }

                    <div class="mb-3">
                        <label asp-for="Monto" class="form-label fw-semibold"></label>
                        <input asp-for="Monto" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Monto" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="MetodoPago" class="form-label fw-semibold">Método de Pago</label>
                            <select asp-for="MetodoPago" class="form-select">
                                <option value="Efectivo">Efectivo</option>
                                <option value="Tarjeta">Tarjeta</option>
                                <option value="Transferencia">Transferencia</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="TipoPago" class="form-label fw-semibold">Tipo de Pago</label>
                            <select asp-for="TipoPago" class="form-select">
                                <option value="Alquiler">Alquiler</option>
                                <option value="Deposito">Depósito</option>
                                <option value="Total">Total</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-success">Confirmar y Guardar Pago</button>
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>