@using SistemadeRenta.Domain.Entities
@model IEnumerable<Reserva>
@{
    ViewData["Title"] = "Módulo de Pagos";
    var pagosRealizados = ViewBag.PagosRealizados as IEnumerable<Pago> ?? Enumerable.Empty<Pago>();
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-0">Gestión de Pagos</h2>
        <small class="text-muted">Administra cobros de reservas aceptadas y consulta el historial</small>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Reservas aceptadas pendientes de pago</h5>
        <span class="badge bg-primary rounded-pill">@Model.Count()</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Cliente</th>
                        <th>Vehículo</th>
                        <th>Inicio</th>
                        <th>Fin</th>
                        <th>Costo Estimado</th>
                        <th class="text-end">Acción</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                No hay reservas aceptadas pendientes de pago en este momento.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td><span class="fw-semibold">@r.CodigoSeguimiento</span></td>
                                <td>@(r.Cliente != null ? $"{r.Cliente.Nombre} {r.Cliente.Apellido}" : $"Cliente #{r.IdCliente}")</td>
                                <td>@(r.Vehiculo != null ? $"{r.Vehiculo.Marca} {r.Vehiculo.Modelo}" : $"Vehículo #{r.IdVehiculo}")</td>
                                <td>@r.FechaInicio.ToString("dd/MM/yyyy")</td>
                                <td>@r.FechaFin.ToString("dd/MM/yyyy")</td>
                                <td class="fw-semibold">@r.CostoEstimado.ToString("C")</td>
                                <td class="text-end">
                                    <a asp-action="Registrar"
                                       asp-route-idReserva="@r.IdReserva"
                                       class="btn btn-primary btn-sm">
                                        Registrar Pago
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Historial de pagos registrados</h5>
        <span class="badge bg-secondary rounded-pill">@pagosRealizados.Count()</span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID Pago</th>
                        <th>Código Reserva</th>
                        <th>Monto</th>
                        <th>Método</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th>Fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!pagosRealizados.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-4">
                                Aún no se han registrado pagos.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var p in pagosRealizados)
                        {
                            <tr>
                                <td>#@p.IdPago</td>
                                <td>@(p.AlquilerContrato?.Reserva?.CodigoSeguimiento ?? $"Contrato #{p.IdContrato}")</td>
                                <td class="fw-semibold">@p.Monto.ToString("C")</td>
                                <td>@p.MetodoPago</td>
                                <td>@p.TipoPago</td>
                                <td>
                                    <span class="badge bg-success">@p.Estado</span>
                                </td>
                                <td>@p.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>