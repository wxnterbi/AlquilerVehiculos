<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Renta</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemadeRenta.Presentation.styles.css" asp-append-version="true" />

    <style>
            body {
                background: #f4f6fb;
                color: #1f2937;
            }

            /* Barra superior, mismo degradado del login */
            .navbar-app {
                background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 100%);
                box-shadow: 0 4px 18px rgba(30, 58, 138, .25);
            }

                .navbar-app .navbar-brand {
                    color: #fff;
                    font-weight: 700;
                    letter-spacing: .3px;
                }

                .navbar-app .nav-link {
                    color: rgba(255, 255, 255, .85);
                    font-weight: 500;
                }

                    .navbar-app .nav-link:hover,
                    .navbar-app .nav-link:focus {
                        color: #fff;
                    }

                .navbar-app .navbar-text {
                    color: rgba(255, 255, 255, .85);
                }

            .brand-icon {
                width: 36px;
                height: 36px;
                border-radius: 10px;
                background: #fff;
                color: #1e3a8a;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                margin-right: .6rem;
            }

            /* Tarjetas, botones y títulos de todas las pantallas */
            main h1, main h2, main h3 {
                color: #1e2a44;
                font-weight: 700;
            }

            main .card {
                border: 0;
                border-radius: 16px;
                overflow: hidden;
                box-shadow: 0 6px 20px rgba(31, 45, 61, .08);
                transition: transform .2s ease, box-shadow .2s ease;
            }

                main .card:hover {
                    transform: translateY(-4px);
                    box-shadow: 0 14px 30px rgba(31, 45, 61, .16);
                }

            main .card-img-top {
                object-fit: cover;
            }

            main .btn {
                border-radius: 10px;
                font-weight: 600;
            }

            main .btn-primary {
                background-color: #2563eb;
                border-color: #2563eb;
            }

                main .btn-primary:hover {
                    background-color: #1e3a8a;
                    border-color: #1e3a8a;
                }

            main .btn-outline-primary {
                color: #2563eb;
                border-color: #2563eb;
            }

                main .btn-outline-primary:hover {
                    background-color: #2563eb;
                    border-color: #2563eb;
                    color: #fff;
                }

            main .form-control:focus,
            main .form-select:focus {
                border-color: #2563eb;
                box-shadow: 0 0 0 .2rem rgba(37, 99, 235, .2);
            }

            footer.footer {
                border-top: 0 !important;
                background: transparent;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark navbar-app mb-4">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-controller="Reservas" asp-action="Index">
                    <span class="brand-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="7" cy="17" r="2" />
                            <circle cx="17" cy="17" r="2" />
                            <path d="M5 17h-2v-6l2-5h9l4 5h1a2 2 0 0 1 2 2v4h-2m-4 0h-6m-6 -6h15m-6 0v-5" />
                        </svg>
                    </span>
                    Sistema de Renta
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1">

                        @if (User.IsInRole("Administrador"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Vehiculos" asp-action="Catalogo">
                                    Administrar vehículos
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reservas" asp-action="Solicitudes">
                                    Solicitudes de reserva
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reservas" asp-action="Index">
                                    Catálogo de vehículos
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Reservas" asp-action="Consultar">
                                    Consultar mi reserva
                                </a>
                            </li>
                        }

                    </ul>

                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item me-3">
                                <span class="navbar-text">Hola, @User.Identity.Name</span>
                            </li>

                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-light btn-sm" asp-controller="Account" asp-action="Login">
                                    Acceso administrador
                                </a>
                            </li>
                        }
                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-4">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-muted">
        <div class="container text-center py-3 small">
            &copy; @DateTime.Now.Year - Sistema de Renta
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>