    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{

    ViewData["Title"] = "Probar subida de imagen";
}

<h1>Probar conexión con Cloudinary</h1>

<p>Selecciona una foto JPG o PNG de hasta 5 MB.</p>

<div asp-validation-summary="All" class="text-danger"></div>

<form asp-controller="PruebaImagen"
      asp-action="Index"
      method="post"
      enctype="multipart/form-data">

    <input type="file"
           name="foto"
           accept=".jpg,.jpeg,.png"
           class="form-control mb-3"
           required />

    <button type="submit" class="btn btn-primary">
        Subir foto de prueba
    </button>
</form>

@if (ViewBag.ImagenUrl != null)
{
    <div class="alert alert-success mt-3">
        ¡La foto se subió correctamente a Cloudinary!
    </div>

    <img src="@ViewBag.ImagenUrl"
         alt="Imagen de prueba"
         class="img-fluid"
         style="max-height: 350px;" />
}
